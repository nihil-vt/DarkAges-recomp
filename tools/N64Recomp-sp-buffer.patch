+// SP memory buffer (separate from RDRAM). The game accesses SP memory at
+// 0xA0000000-0xA0800000 during boot for DMA data.
+extern uint8_t* sp_buffer;
+
+// Compute the host pointer for a MIPS virtual address.
+// kseg0 (0x80000000-based) maps to RDRAM. kseg1 (0xA0000000-based) maps to SP
+// memory (separate buffer) because the recomp has no SP DMA hardware.
+static inline uint8_t* mips_addr_to_ptr(gpr addr) {
+    // Check the address range to determine RDRAM vs SP memory.
+    if ((uint32_t)(addr) >= 0xA0000000u && (uint32_t)(addr) < 0xA0800000u) {
+        // SP memory: map to sp_buffer.
+        size_t offset = (size_t)(addr) - (size_t)0xFFFFFFFFA0000000ULL;
+        return sp_buffer + offset;
+    }
+    // RDRAM (kseg0): map to rdram.
+    size_t offset = (size_t)(addr) - (size_t)0xFFFFFFFF80000000ULL;
+    return (uint8_t*)((size_t)rdram + offset);
+}
