+static inline uint8_t* mips_addr_to_ptr(gpr addr) {
+    // Check for MMIO ranges first - these should NOT map to RDRAM.
+    // VI registers: 0xFFFFFFFFA4400000-0xFFFFFFFFA440003F
+    if (addr >= 0xFFFFFFFFA4400000ULL && addr < 0xFFFFFFFFA4400040ULL) {
+        size_t offset = (size_t)(addr) - (size_t)0xFFFFFFFFA4400000ULL;
+        return get_mace_vi_regs() + offset;
+    }
+    // Check the address range to determine RDRAM vs SP memory.
+    if (addr >= 0xFFFFFFFFA0000000ULL && addr < 0xFFFFFFFFA0800000ULL) {
+        // SP memory: map to sp_buffer.
+        size_t offset = (size_t)(addr) - (size_t)0xFFFFFFFFA0000000ULL;
+        if (offset >= 0x800000) return get_safe_mem_buf();
+        return sp_buffer + offset;
+    }
+    // kseg0: 0xFFFFFFFF80000000-0xFFFFFFFF9FFFFFFF maps to RDRAM (cached)
+    if (addr >= 0xFFFFFFFF80000000ULL && addr <= 0xFFFFFFFF9FFFFFFFULL) {
+        size_t offset = (size_t)(addr) - (size_t)0xFFFFFFFF80000000ULL;
+        if (offset >= 0x1F000000ULL) return get_safe_mem_buf();
+        return (uint8_t*)((size_t)rdram + offset);
+    }
+    // kseg1: 0xFFFFFFFFA0000000-0xFFFFFFFFBFFFFFFF (uncached, maps to same physical as kseg0)
+    if (addr >= 0xFFFFFFFFA0000000ULL && addr <= 0xFFFFFFFFBFFFFFFFULL) {
+        size_t offset = (size_t)(addr) - (size_t)0xFFFFFFFFA0000000ULL;
+        if (offset >= 0x1F000000ULL) return get_safe_mem_buf();
+        return (uint8_t*)((size_t)rdram + offset);
+    }
+    // Any other address is invalid - return safe buffer.
+    return get_safe_mem_buf();
+}
